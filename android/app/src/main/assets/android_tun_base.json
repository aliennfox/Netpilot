{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    }
  },
  "dns": {
    "servers": [
      { "type": "https", "tag": "cf-doh", "server": "1.1.1.1", "detour": "proxy-group" },
      { "type": "udp", "tag": "local-dns", "server": "223.5.5.5" }
    ],
    "rules": [
      { "ip_is_private": true, "server": "local-dns" }
    ],
    "final": "cf-doh",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": false,
      "endpoint_independent_nat": false,
      "stack": "gvisor"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy-group",
      "outbounds": ["direct-out"],
      "default": "direct-out"
    },
    { "type": "direct", "tag": "direct-out" }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local-dns",
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct-out" }
    ],
    "final": "proxy-group"
  }
}
